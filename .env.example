# Neon: connessione pooled (host con "-pooler")
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Neon: connessione diretta (per Prisma Migrate)
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Segreto per l'hash (HMAC) dei codici personali: stringa casuale lunga, es. `openssl rand -base64 32`.
# Se cambia, tutti i codici personali esistenti smettono di funzionare.
AUTH_SECRET="cambia-questo-segreto-casuale-lungo"

# Super admin tecnico (sola lettura)
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="cambia-questa-password-lunga"

# TelemetryDeck (opzionale: senza, la telemetria è disattivata)
TELEMETRY_DECK_APP_ID=
