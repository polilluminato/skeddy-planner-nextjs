generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

/// Account "Amministrazione": crea e gestisce più team (Company). Non è un User.
model Organization {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  companies Company[]
  sessions  Session[]
}

model Company {
  id             String   @id @default(cuid())
  /// null per le aziende singole
  organizationId String?
  name           String
  code           String   @unique
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  shifts       Shift[]
  messages     Message[]

  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  companyId      String
  firstName      String
  lastName       String
  role           Role     @default(EMPLOYEE)
  isOwner        Boolean  @default(false)
  email          String?  @unique
  passwordHash   String?
  /// HMAC-SHA256 del codice personale (AUTH_SECRET come pepper)
  codeHash       String   @unique
  weeklyMinutes  Int      @default(0)
  color          String
  /// Ultima apertura delle notifiche: i messaggi successivi sono "non letti"
  messagesReadAt DateTime @default(now())
  createdAt      DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shifts   Shift[]
  sessions Session[]
  messages Message[]

  @@index([companyId])
}

model Shift {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  date      DateTime @db.Date
  /// HH:MM
  start     String
  /// HH:MM
  end       String
  note      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([userId, date])
}

/// Notifica scritta da un amministratore per tutta l'azienda
model Message {
  id               String   @id @default(cuid())
  companyId        String
  /// null se l'autore è stato eliminato o se scrive l'Amministrazione
  authorId         String?
  /// Scritto dall'Amministrazione (organizzazione) del team
  fromOrganization Boolean  @default(false)
  body             String
  createdAt        DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

model Session {
  id              String   @id @default(cuid())
  tokenHash       String   @unique
  userId          String?
  organizationId  String?
  /// Team su cui sta operando l'Amministrazione
  activeCompanyId String?
  isSuperAdmin    Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model LoginAttempt {
  key         String    @id
  count       Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}
